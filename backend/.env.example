HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database
# По умолчанию — SQLite: файл backend/.tmp/data.db создаётся автоматически.
# Денежные гарантии (UNIQUE/CHECK) работают и на SQLite, и на PostgreSQL.
DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db

# PostgreSQL (рекомендуется для прода/стейджа):
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=unifiedstack
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SSL=false
# DATABASE_SCHEMA=public
# DATABASE_URL=postgres://strapi:strapi@localhost:5432/unifiedstack
# DATABASE_ISOLATION_LEVEL="read committed"

# Аккаунт для ручной проверки (bootstrap) — оставьте пустым, если не нужно
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Rate limit на создание тикетов поддержки
SUPPORT_TICKET_RATE_LIMIT=5
SUPPORT_TICKET_RATE_WINDOW_MS=600000

# Payment webhook (T-03) and CORS whitelist
PAYMENT_WEBHOOK_SECRET=change_me_payment_webhook_secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
