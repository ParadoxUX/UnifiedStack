# Адрес Strapi (для серверных запросов Next.js)
STRAPI_INTERNAL_URL=http://127.0.0.1:1337
NEXT_PUBLIC_STRAPI_URL=http://127.0.0.1:1337

# Демо-режим пополнения (только для локального стенда).
# В проде оставить false: зачисление идёт только вебхуком провайдера.
DEMO_PAYMENTS=false

# Секрет подписи платёжного webhook (должен совпадать с backend/.env)
PAYMENT_WEBHOOK_SECRET=
